# Copy this file to config/.env and fill in real values.
# config/.env is gitignored - never commit real tokens.
# Leave a value blank to skip that platform gracefully.

# --- Hugging Face (free video/image generation) ---
# Create a free account at huggingface.co, then a Read token at
# huggingface.co/settings/tokens. Using your own token gives your
# account's full daily free ZeroGPU quota (anonymous calls get less).
HF_TOKEN=

# --- Project account email (new accounts, provided by the owner) ---
ACCOUNT_EMAIL=

# --- Instagram (Business/Creator account linked to a Facebook Page) ---
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# --- Facebook Page (Page access token with pages_manage_posts) ---
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=

# --- YouTube (JSON with refresh_token/client_id/client_secret/token_uri,
# --- produced by scripts/youtube_oauth_setup.py) ---
YOUTUBE_TOKEN=
